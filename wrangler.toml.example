# デプロイ設定テンプレート。
# `cp wrangler.toml.example wrangler.toml` して値を埋める。
# wrangler.toml は .gitignore 済み（実 KV id・設定値を含むためコミットしない）。
name = "line-order-api"
main = "src/index.ts"
workers_dev = true
compatibility_date = "2026-03-05"
kv_namespaces = [
  { binding = "KV", id = "REPLACE_WITH_OWN_KV_NAMESPACE_ID" }
]

# 非秘匿の環境変数。秘匿値（LINE_CHANNEL_SECRET / SESSION_SECRET /
# SLACK_BOT_TOKEN / SLACK_SIGNING_SECRET）は wrangler secret put で登録する。
[vars]
FRONTEND_URL = "<本番フロントのURL>"
LINE_CHANNEL_ID = "<your-line-channel-id>"
SLACK_CHANNEL_ID = "<your-slack-channel-id>"
LINE_TEMPLATE_OPEN = "<template-name>_ja"
LINE_TEMPLATE_DONE = "<template-name>_ja"
