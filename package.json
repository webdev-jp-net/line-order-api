{
	"name": "line-auth-api",
	"version": "1.0.0",
	"description": "LINE Login + Cloudflare Workers + KV 認証API",
	"main": "index.js",
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"build:watch": "tsc --watch",
		"start": "node dist/index.js",
		"dev": "wrangler dev --config wrangler.dev.toml",
		"deploy": "wrangler deploy --config wrangler.toml",
		"lint": "biome lint --write"
	},
	"keywords": ["line", "login", "oauth", "cloudflare-workers", "hono"],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"hono": "^4.6.14"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20241218.0",
		"@types/node": "^22.10.5",
		"biome": "^0.3.3",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.2",
		"wrangler": "^3.99.0"
	}
}
