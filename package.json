{
	"name": "line-order-api",
	"version": "0.1.0",
	"description": "LINE MINI App 注文受付 API（Cloudflare Workers + Hono + KV）",
	"main": "index.js",
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"build:watch": "tsc --watch",
		"start": "node dist/index.js",
		"dev": "wrangler dev --config wrangler.dev.toml",
		"deploy": "wrangler deploy --config wrangler.toml",
		"format": "biome format --write src/ && textlint --fix \"**/*.md\"",
		"lint": "biome lint --write src/"
	},
	"license": "ISC",
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@cloudflare/workers-types": "^5.20261021.1",
		"@types/node": "^26.6.5",
		"textlint": "^15.8.0",
		"textlint-rule-preset-jtf-style": "^3.0.3",
		"tsconfig-paths": "^4.2.0"
	},
	"pnpm": {
		"minimumReleaseAge": 10080,
		"overrides": {
			"jsdom": "25.0.1",
			"jsdom>parse5": "7.3.0"
		}
	},
	"dependencies": {
		"hono": "^4.13.13",
		"typescript": "^7.0.2",
		"wrangler": "^4.151.3"
	}
}
